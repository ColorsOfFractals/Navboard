!ifndef PROJECT_ROOT
    !define PROJECT_ROOT ".."
!endif

!ifndef WEBVIEW2_INSTALLER
    !error "Supply WEBVIEW2_INSTALLER using /DWEBVIEW2_INSTALLER=path"
!endif

!include "MUI2.nsh"
!include "FileFunc.nsh"
!include "x64.nsh"

; Basic installer attributes
Name "Navboard"
OutFile "Navboard_0.1.0_x64-setup.exe"
Unicode true
InstallDir "$LOCALAPPDATA\Programs\Navboard"

; Request appropriate privileges
RequestExecutionLevel user

; Version information
VIProductVersion "0.1.0.0"
VIAddVersionKey /LANG=1033 "LegalCopyright" "Copyright 2026 ColorsOfFractals"
VIAddVersionKey "ProductName" "Navboard"
VIAddVersionKey "FileVersion" "0.1.0"
VIAddVersionKey "ProductVersion" "0.1.0"
VIAddVersionKey "FileDescription" "Navboard Installer"
VIAddVersionKey "CompanyName" "ColorsOfFractals"

; MUI settings
!define MUI_ABORTWARNING

; Pages
!define MUI_ICON "Navboard.ico"
!define MUI_UNICON "Navboard.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP "Welcome.bmp"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "Header.bmp"
!define MUI_WELCOMEPAGE_TITLE "Welcome to Navboard"
!define MUI_WELCOMEPAGE_TEXT "Create up close. Organize from afar. Present anywhere."
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

; Uninstaller pages
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; Language
!insertmacro MUI_LANGUAGE "English"

; Installer section
Section "Install"
    ; Detect Evergreen WebView2 before installing application files.
    SetRegView 32
    ReadRegStr $0 HKLM "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
    StrCmp $0 "" wv_user
    StrCmp $0 "0.0.0.0" wv_user wv_ready
    wv_user:
    ReadRegStr $0 HKCU "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
    StrCmp $0 "" wv_install
    StrCmp $0 "0.0.0.0" wv_install wv_ready
    wv_install:
    InitPluginsDir
    SetOutPath "$PLUGINSDIR"
    File /oname=WebView2Setup.exe "${WEBVIEW2_INSTALLER}"
    ExecWait '"$PLUGINSDIR\WebView2Setup.exe" /silent /install' $1
    ReadRegStr $0 HKLM "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
    StrCmp $0 "" wv_recheck_user
    StrCmp $0 "0.0.0.0" wv_recheck_user wv_ready
    wv_recheck_user:
    ReadRegStr $0 HKCU "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
    StrCmp $0 "" wv_failed
    StrCmp $0 "0.0.0.0" wv_failed wv_ready
    wv_failed:
    MessageBox MB_OK|MB_ICONSTOP "WebView2 Runtime could not be verified. Install the Evergreen Runtime and retry Navboard setup."
    SetErrorLevel 1
    Abort
    wv_ready:
    DetailPrint "WebView2 Runtime detected: $0"
    SetRegView 32
    SetOutPath $INSTDIR

    ; Install main binary
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\navboard.exe"

    ; Install resources
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\Navboard_Icon-dxh2d1cbebf55a8eabc.png"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\atlas-dxhb5b6f8ffaedf3d7e.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\canvas-dxh1fac6d9d986fdf74.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\clock-dxhebe152dc61a55dd1.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\echo-dxh41ac3c3615f6129.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\forge-dxha170c7f71b7e688e.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\lens-dxhf424161ed0c52c47.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\main-dxhdbe5fd38179be31c.css"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\specs-dxhf83db41f4e79aaa.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\stitch-dxh14e8741c4e8c50ae.svg"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\tailwind-dxh84d98105ba82894.css"
    SetOutPath "$INSTDIR\assets"
    File "${PROJECT_ROOT}\target\dx\navboard\bundle\windows\nsis\_staging\assets\text-dxh10d154d84e22147c.svg"

    SetOutPath $INSTDIR

    ; Create uninstaller
    File /oname=Navboard.ico "Navboard.ico"
        SetOutPath "$INSTDIR\echo-lab"
    File "${PROJECT_ROOT}\echo-lab\echo_worker.py"
    File "${PROJECT_ROOT}\echo-lab\Setup-Echo.ps1"
    File "${PROJECT_ROOT}\echo-lab\requirements-win-x64.lock"
    SetOutPath "$INSTDIR"
    File "${PROJECT_ROOT}\LICENSE"
