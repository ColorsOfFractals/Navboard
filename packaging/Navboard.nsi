    ; Create Start Menu shortcuts
    CreateDirectory "$SMPROGRAMS\Navboard"
    CreateShortcut "$SMPROGRAMS\Navboard\Navboard.lnk" "$INSTDIR\navboard.exe" "" "$INSTDIR\Navboard.ico" 0
    CreateShortcut "$SMPROGRAMS\Navboard\Uninstall Navboard.lnk" "$INSTDIR\uninstall.exe"

    ; Create Desktop shortcut
    CreateShortcut "$DESKTOP\Navboard.lnk" "$INSTDIR\navboard.exe" "" "$INSTDIR\Navboard.ico" 0

    ; Write registry keys for Add/Remove Programs
    WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\com.colorsoffractals.navboard" \
        "DisplayName" "Navboard"
    WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\com.colorsoffractals.navboard" \
        "UninstallString" '"$INSTDIR\uninstall.exe"'
    WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\com.colorsoffractals.navboard" \
        "DisplayVersion" "0.1.0"
    WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\com.colorsoffractals.navboard" \
        "Publisher" "ColorsOfFractals"
    WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\com.colorsoffractals.navboard" \
        "InstallLocation" "$INSTDIR"

    ; Get installed size
    ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
    IntFmt $0 "0x%08X" $0
    WriteRegDWORD SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\com.colorsoffractals.navboard" \
        "EstimatedSize" "$0"



SectionEnd


